# VITE_ variables are public. Never place secrets in them.

# Production origin used for canonical URLs, absolute share-image URLs, structured
# data, and the sitemap. Required for reliable link previews on social platforms.
# VITE_SITE_URL=https://www.example.com

# Contact form endpoint: the PHP service in server/, deployed on its own subdomain.
# Empty keeps the email-app hand-off. Locally: http://127.0.0.1:8787
# VITE_CONTACT_ENDPOINT=https://api.example.com/

# Server-only settings for server/ (never prefix these with VITE_). On the host,
# put them in a .env above public_html; see server/.env.example for every option.
BREVO_API_KEY=
CONTACT_SENDER_EMAIL=
CONTACT_STUDIO_EMAIL=
CONTACT_SITE_URL=
