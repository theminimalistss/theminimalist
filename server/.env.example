# Copy to a .env file (git-ignored) and fill in real values. On the host, place it
# in the folder above public_html. Locally, the repository's root .env also works.
# Host variables take precedence.

# Brevo → SMTP & API → API keys.
BREVO_API_KEY=

# A sender verified in Brevo (Senders, domains & dedicated IPs).
CONTACT_SENDER_EMAIL=hello@your-domain.com
CONTACT_SENDER_NAME="The Minimalist — Design Studio"

# Where new inquiries are delivered.
CONTACT_STUDIO_EMAIL=theminimalistss@gmail.com
CONTACT_STUDIO_NAME="The Minimalist"

# The public website. It is also the default allowed origin and hosts the email logo.
CONTACT_SITE_URL=https://www.your-domain.com
CONTACT_ALLOWED_ORIGINS=https://www.your-domain.com,https://your-domain.com
# CONTACT_LOGO_URL=https://www.your-domain.com/email/lotus.png

CONTACT_STUDIO_HOURS="7:00 AM – 11:00 AM"
CONTACT_TIMEZONE=Asia/Manila
CONTACT_RATE_LIMIT_ATTEMPTS=5
CONTACT_RATE_LIMIT_WINDOW=900
CONTACT_SEND_CONFIRMATION=true
